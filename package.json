{
  "name": "dsh-learnhub",
  "description": "学习中心 Learnhub：DeepSeek Harness 的学习引擎插件（106 个 agent 工具 + /learnhub 面板 + 侧边栏入口）",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maozhijie/learnhub-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/maozhijie/learnhub-plugin/issues"
  },
  "homepage": "https://github.com/maozhijie/learnhub-plugin#readme",
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "web",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "prepare": "node scripts/link-peers.mjs",
    "test": "node --experimental-transform-types --test tests/*.test.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-schedule": "*",
    "@deepseek-ai/dsh-time-context": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-schedule": {
      "optional": true
    },
    "@deepseek-ai/dsh-time-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@open-spaced-repetition/binding": "^0.5.0",
    "ts-fsrs": "^5.4.2",
    "yaml": "^2.9.0"
  }
}
